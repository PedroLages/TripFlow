# TripFlow Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Gemini AI (for AI-powered suggestions)
# ===========================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# Supabase Backend (optional)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ===========================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ===========================================
# Map Tile Provider (for MapLibre - optional)
# ===========================================

# Stadia Maps (2,500 free credits/month)
# Get key from: https://stadiamaps.com/
VITE_STADIA_MAPS_API_KEY=your_stadia_key_here

# OR MapTiler (free tier available)
# Get key from: https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# Note: OpenFreeMap requires no API key!

# ===========================================
# OpenRouteService (for directions & routing)
# ===========================================

# OpenRouteService (2000 free requests/day)
# Get key from: https://openrouteservice.org/dev/#/signup
VITE_OPENROUTE_API_KEY=your_openroute_key_here

# ===========================================
# Apple Maps (MapKit JS for web + MapKit for iOS)
# ===========================================

# Apple Developer Team ID (found in top-right of developer.apple.com)
VITE_APPLE_MAPS_TEAM_ID=YOUR_TEAM_ID

# MapKit JS Key ID (from creating the .p8 key)
VITE_APPLE_MAPS_KEY_ID=YOUR_KEY_ID

# Maps Identifier (e.g., com.yourcompany.tripflow.web)
VITE_APPLE_MAPS_IDENTIFIER=com.yourcompany.tripflow.web

# Private key file path (SERVER-SIDE ONLY - never commit this file!)
# Download from Apple Developer portal (only available once)
APPLE_MAPS_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Token API endpoint (defaults to http://localhost:3002)
VITE_MAPKIT_TOKEN_API=http://localhost:3002/api/mapkit-token
